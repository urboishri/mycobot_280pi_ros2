<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_280pi_description</name>
  <version>0.1.0</version>
  <description>
    URDF description package for the myCobot 280 Pi 6-DOF robotic arm.
    Contains robot geometry, visual meshes, collision meshes, and
    a launch file for RViz visualization.
  </description>

  <maintainer email="you@example.com">Youniq</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool: needed to run CMake itself -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- These are EXEC dependencies (needed at runtime, not compile time)   -->
  <!-- because this package has no C++ code — it only installs files       -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>